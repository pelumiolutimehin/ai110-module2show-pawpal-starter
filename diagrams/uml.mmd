classDiagram
    %% Draft v2 - keep updated so it matches the final implementation.

    class Priority {
        <<enumeration>>
        LOW = 1
        MEDIUM = 2
        HIGH = 3
    }

    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +remove_pet(pet) None
    }

    class Pet {
        +str name
        +str species
        +str breed
        +list~Task~ tasks_list
        +add_task(task) None
        +remove_task(task) None
        +complete_task(task) None
        +pending_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration
        +Priority priority
        +str category
        +str frequency
        +time fixed_time
        +date due_date
        +bool completed
        +str pet_name
        +mark_complete() Task
        +is_due(day) bool
    }

    class Scheduler {
        +Owner owner
        +generate_plan(day) Plan
        -sort_tasks(tasks) list~Task~
        -fit_to_time(tasks, minutes) tuple
        +find_conflicts(tasks) list
    }

    class Plan {
        +list~ScheduledItem~ items
        +list~SkippedTask~ skipped
        +total_minutes int
        +explain() str
    }

    class ScheduledItem {
        +Task task
        +datetime start_time
        +datetime end_time
        +str reason
    }

    class SkippedTask {
        +Task task
        +str reason
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" o-- "*" Task : has
    Task --> Priority
    Scheduler --> Owner : reads time and prefs
    Scheduler ..> Plan : creates
    Plan "1" *-- "*" ScheduledItem : contains
    Plan "1" *-- "*" SkippedTask : contains
    ScheduledItem --> Task
    SkippedTask --> Task
